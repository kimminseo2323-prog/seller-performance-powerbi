	partition seller_scorecard = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\seller_scorecard.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"seller_id", "orders_3m", "gmv_3m", "late_handoff_rate", "late_delivery_rate", "avg_review", "low_review_rate", "cancel_rate", "gmv_rank", "seller_grade"}),
