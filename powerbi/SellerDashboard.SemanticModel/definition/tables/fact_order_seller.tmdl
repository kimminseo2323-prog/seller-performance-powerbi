	partition fact_order_seller = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_order_seller.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"order_id", "seller_id", "customer_unique_id", "customer_state", "purchase_date", "order_status", "item_cnt", "gmv", "freight", "main_category", "lead_time_days", "handoff_days", "is_late_delivery", "is_late_handoff", "delivery_status", "is_canceled", "review_score", "is_low_review", "complaint_type", "is_multi_seller_order"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"order_id", type text}, {"seller_id", type text}, {"customer_unique_id", type text}, {"customer_state", type text}, {"purchase_date", type date}, {"order_status", type text}, {"item_cnt", Int64.Type}, {"gmv", type number}, {"freight", type number}, {"main_category", type text}, {"lead_time_days", type number}, {"handoff_days", type number}, {"is_late_delivery", Int64.Type}, {"is_late_handoff", Int64.Type}, {"delivery_status", type text}, {"is_canceled", Int64.Type}, {"review_score", Int64.Type}, {"is_low_review", Int64.Type}, {"complaint_type", type text}, {"is_multi_seller_order", Int64.Type}}, "en-US")
				in
				    Typed

