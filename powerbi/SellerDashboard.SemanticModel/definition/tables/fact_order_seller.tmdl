table fact_order_seller
	lineageTag: c4c14474-be87-5bbf-a720-a084987fb499

	measure 매출 = SUM(fact_order_seller[gmv])
		formatString: #,0
		displayFolder: 1 규모
		lineageTag: dc6a9206-b5b0-526d-aad4-11318a3ec574

	measure '주문 건수' = COUNTROWS(fact_order_seller)
		formatString: #,0
		displayFolder: 1 규모
		lineageTag: 9879bc7f-343a-51ca-a0cc-1b16447d36d5

	measure '활성 판매자 수' = DISTINCTCOUNT(fact_order_seller[seller_id])
		formatString: #,0
		displayFolder: 1 규모
		lineageTag: dda74998-c3fc-5d55-b34f-422c757f4db2

	measure '신규 판매자 수' = CALCULATE(COUNTROWS(dim_seller), TREATAS(VALUES(dim_date[month_start]), dim_seller[cohort_month]))
		formatString: #,0
		displayFolder: 1 규모
		lineageTag: 272a2f88-807f-5050-96b9-da10c551b2f2

	measure 객단가 = DIVIDE([매출], [주문 건수])
		formatString: #,0
		displayFolder: 1 규모
		lineageTag: ebcc7979-0910-5893-adbc-e4025f609f7f

	measure '매출 전월 대비' =
			VAR cur = [매출]
			VAR prev = CALCULATE([매출], DATEADD(dim_date[date], -1, MONTH))
			RETURN DIVIDE(cur - prev, prev)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 규모
		lineageTag: 0ca2efb8-82c8-577b-a603-d194df3443ca

	measure '배송 지연율' = AVERAGE(fact_order_seller[is_late_delivery])
		formatString: 0.0%
		displayFolder: 2 운영 품질
		lineageTag: f9411bb1-9a54-53c6-84a6-35048cfeddee

	measure '출고 지연율' = AVERAGE(fact_order_seller[is_late_handoff])
		formatString: 0.0%
		displayFolder: 2 운영 품질
		lineageTag: 1911acfd-f080-50be-8c42-ee2da1c2306a

	measure '평균 리드타임(일)' = AVERAGE(fact_order_seller[lead_time_days])
		formatString: 0.0
		displayFolder: 2 운영 품질
		lineageTag: 59dcce89-9b74-54eb-bac5-8c98b12d4ac5

	measure '평균 출고 소요(일)' = AVERAGE(fact_order_seller[handoff_days])
		formatString: 0.0
		displayFolder: 2 운영 품질
		lineageTag: 2b51d44f-02aa-59c5-b932-a55a500ae295

	measure 취소율 = AVERAGE(fact_order_seller[is_canceled])
		formatString: 0.0%
		displayFolder: 2 운영 품질
		lineageTag: 140af45f-142f-575b-bf32-affe9b2fb223

	measure '평균 평점' = AVERAGE(fact_order_seller[review_score])
		formatString: 0.00
		displayFolder: 3 고객 반응
		lineageTag: 5e5d39bd-1ef0-53ae-b72e-828c8c5f9d62

	measure '저평점 비율' = AVERAGE(fact_order_seller[is_low_review])
		formatString: 0.0%
		displayFolder: 3 고객 반응
		lineageTag: 8e916306-1a65-5dea-8d44-def2b4ccc266

	measure '불만 건수' = CALCULATE(COUNTROWS(fact_order_seller), KEEPFILTERS(NOT ISBLANK(fact_order_seller[complaint_type])))
		formatString: #,0
		displayFolder: 3 고객 반응
		lineageTag: 4273c79a-aa35-513c-aa65-32b965b978d3

	measure '1천 주문당 불만' = DIVIDE([불만 건수], [주문 건수]) * 1000
		formatString: 0.0
		displayFolder: 3 고객 반응
		lineageTag: 27f12479-e06f-5f50-9324-8543b9349dae

	measure '지연 배송 저평점 비율' = CALCULATE([저평점 비율], fact_order_seller[delivery_status] = "지연 배송")
		formatString: 0.0%
		displayFolder: 3 고객 반응
		lineageTag: 17423bda-425a-514a-983f-69dea9bcd793

	measure '정시 배송 저평점 비율' = CALCULATE([저평점 비율], fact_order_seller[delivery_status] = "정시 배송")
		formatString: 0.0%
		displayFolder: 3 고객 반응
		lineageTag: 8dcd3c5e-4539-5fb8-821a-946732068019

	measure '성과표 판매자 수' = COUNTROWS(seller_scorecard)
		formatString: #,0
		displayFolder: 4 성과표
		lineageTag: ec6297dc-17c6-54b8-b8a1-7d2c373797c0

	measure '성과표 출고 지연율' = AVERAGE(seller_scorecard[late_handoff_rate])
		formatString: 0.0%
		displayFolder: 4 성과표
		lineageTag: ddba1e30-14d1-5db9-b0f7-b60afbd7dbd4

	measure '성과표 저평점 비율' = AVERAGE(seller_scorecard[low_review_rate])
		formatString: 0.0%
		displayFolder: 4 성과표
		lineageTag: 7309a179-4127-56c6-a543-0ecf5baf1374

	measure '성과표 매출' = SUM(seller_scorecard[gmv_3m])
		formatString: #,0
		displayFolder: 4 성과표
		lineageTag: 88df82c8-2dd9-5981-a721-57e26a804036

